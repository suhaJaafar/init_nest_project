<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN"
  "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html
  xmlns="http://www.w3.org/1999/xhtml"
  lang="{{#if arabic}}ar{{else}}en{{/if}}"
  dir="{{#if arabic}}rtl{{else}}ltr{{/if}}">
<head>
  <meta charset="UTF-8">
  <meta content="width=device-width, initial-scale=1" name="viewport">
  <meta name="x-apple-disable-message-reformatting">
  <meta http-equiv="Content-Type" content="text/html charset=UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>{{title}}</title>
  <style>
    p, ol, ul {
      max-width: 90%;
    }
  </style>
</head>
<body style="padding: 10px; font-size: 16px;">
<div
  style="background-color: #f4f5f6; padding: 20px; border-radius: 10px; overflow: hidden;"
  {{#if arabic}}dir="rtl"{{/if}}>
  <center>
    <div style="text-align: center; max-width: 50%;">
      <img
        src="https://api.Tawaslapp.com/brand-text.png"
        alt="Tawasl App Logo"
        style="width: 100%; height: auto; object-fit: contain; margin-top: 10px; margin-bottom: 15px; aspect-ratio: 2/1;"
        width="300" title="Tawasl App Logo" height="113">
    </div>
  </center>
  {{> @partial-block }}
</div>
</body>
</html>
